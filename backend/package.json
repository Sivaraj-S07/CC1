{
  "name": "quiz-assessment-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "REST API backend for the College Quiz & Assessment Management System (Express + Supabase).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "hash-password": "node scripts/hash-password.js",
    "check:runtimes": "node scripts/check-runtimes.js",
    "setup:compilers": "node scripts/setup-compilers.js",
    "test": "node --test tests/quizClone.test.js tests/quizCloneLegacyDb.test.js tests/quizPdf.test.js",
    "test:judge": "node --test tests/judgeAllLanguages.test.js tests/quizCodeHttp.test.js tests/playgroundHttp.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.1"
  }
}
